# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL pool size: see CONFIG_LV_MEM_SIZE_KILOBYTES in the pocket section below.

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# Pocket: optimise for size (-Os) in release and debug images. Basis: the
# memory probe measured 11.2 KB less static RAM (IRAM code) than the default
# -Og; the Opus encoder's real-time margin is checked by the probe (enc_us
# per 20 ms frame, PCM drops 0).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# --- Pocket firmware ---
# Bonds persist in NVS (above); LE Secure Connections only, no legacy pairing.
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y
# LVGL pool (LVGL 9.5.0 as locked): measured peak + 25 %, rounded up to 1 KB.
# Peak (memory probe, sdkconfig.memprobe.defaults): lv_max_used 16,016 B on
# the pairing-code screen; the 4 KB reply screen reached 15,468 B.
# 16,016 x 1.25 = 20,020 B -> 20 KB. The pool's own
# allocator header takes ~2.6 KB of it (lv_total 30,116 of 32 KB), so the
# free margin above the peak is ~1.8 KB: new screens must be measured with
# the probe (lv_max) before they ship. The reply text is static (not in the
# pool).
CONFIG_LV_MEM_SIZE_KILOBYTES=20
# LVGL draw buffer: 20 lines (9.6 KB) instead of the BSP's 40 (19.2 KB),
# trading redraw time for heap: the memory probe (refr_ms) measured a full
# redraw of the 4 KB reply screen at ~104 ms (40 lines: ~68 ms).
CONFIG_BSP_LVGL_DRAW_BUFFER_LINES=20
# The CJK font (7666 glyphs) needs 32-bit glyph offsets.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y

# --- Pocket standby: automatic light sleep while the BLE link stays up ---
# Frequency scaling and light sleep are configured at run time
# (main/pocket_power.c); PM locks keep the chip awake while the screen is lit
# and while the codec runs.
CONFIG_PM_ENABLE=y
# No light sleep while a USB host is connected (start-of-frame packets seen):
# the USB Serial/JTAG pad is switched off in light sleep, which drops the
# console and, after several sleeps, the port itself on the host. A charger
# sends no SOF, so on a charger the device still sleeps.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# BLE controller sleeps between connection events. The board has no 32 kHz
# crystal (its pins, GPIO0/GPIO1, are the key ladder and LCD CS) and the
# internal 136 kHz RC is outside the 500 ppm the link needs, so the main
# 40 MHz crystal is the low-power clock and stays powered in light sleep.
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
# Keep the CPU powered in light sleep for now. Powering it down saves ~100 uA
# of sleep current for 1.68 KB of heap (ESP-IDF Kconfig figures); with the
# largest free block at ~34 KB the heap can afford it. Off until an on-battery
# measurement after release shows no regression in wake latency, BLE link
# stability or sleep residency.
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n
